# ==============================================================================
# ENVIRONMENT VARIABLES: BAPEMA CAKRAWALA UMJ (VPS / PRODUCTION READINESS)
# Salin file ini menjadi .env di server VPS Anda: cp .env.example .env
# ==============================================================================

# 1. Database Connection URL
# Untuk SQLite di VPS (default):
DATABASE_URL="file:../database/bapema.db"
# Atau jika menggunakan PostgreSQL di VPS:
# DATABASE_URL="postgresql://username:password@localhost:5432/bapema_db?schema=public"
# Atau jika menggunakan MySQL di VPS:
# DATABASE_URL="mysql://username:password@localhost:3306/bapema_db"

# 2. JWT Secret untuk Autentikasi Admin Panel
# Ganti dengan string acak yang kuat di server VPS produksi (min 32 karakter)
JWT_SECRET="ganti_dengan_jwt_secret_acak_dan_aman_untuk_vps_produksi_2026"

# 3. Node Environment & Server Port
NODE_ENV="production"
PORT=3000
