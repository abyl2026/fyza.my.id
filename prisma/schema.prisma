// ==============================================================================
// PRISMA SCHEMA: BAPEMA CAKRAWALA UMJ
// Website Profil & Portal Informasi LPM Universitas Muhammadiyah Jakarta
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("admin") // "master_admin" | "admin"
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  events       Event[]
  articles     Article[]

  @@map("users")
}

model OrganizationProfile {
  id               Int      @id @default(autoincrement())
  orgName          String   @default("BAPEMA Cakrawala Universitas Muhammadiyah Jakarta") @map("org_name")
  shortName        String   @default("BAPEMA Cakrawala UMJ") @map("short_name")
  tagline          String   @default("Suara Cakrawala, Suara Mahasiswa!")
  motto            String   @default("Suara Cakrawala, Suara Mahasiswa!")
  mottoDescription String   @map("motto_description")
  vision           String
  mission          String   // Menyimpan JSON string array butir-butir misi
  aboutText        String   @map("about_text")
  logoUrl          String?  @map("logo_url")
  email            String?  @default("kontak@bapemacakrawala.org")
  phone            String?
  address          String?
  instagramUrl     String?  @map("instagram_url")
  linkedinUrl      String?  @map("linkedin_url")
  youtubeUrl       String?  @map("youtube_url")
  twitterUrl       String?  @map("twitter_url")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("organization_profile")
}

model LeaderProfile {
  id           Int      @id @default(autoincrement())
  name         String
  position     String   @default("Ketua Umum")
  period       String   // e.g. "Periode 2026/2027"
  quote        String
  photoUrl     String?  @map("photo_url")
  instagramUrl String?  @map("instagram_url")
  linkedinUrl  String?  @map("linkedin_url")
  isActive     Int      @default(1) @map("is_active") // 1: aktif, 0: non-aktif
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("leader_profile")
}

model Division {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  description String?
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  members     Member[]
  programs    DivisionProgram[]

  @@map("divisions")
}

model Member {
  id           Int      @id @default(autoincrement())
  divisionId   Int      @map("division_id")
  name         String
  position     String
  photoUrl     String?  @map("photo_url")
  instagramUrl String?  @map("instagram_url")
  linkedinUrl  String?  @map("linkedin_url")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Int      @default(1) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  division     Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@map("members")
}

model DivisionProgram {
  id           Int      @id @default(autoincrement())
  divisionId   Int      @map("division_id")
  name         String
  description  String
  targetOutput String?  @map("target_output")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  division     Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@map("division_programs")
}

model TimelineEvent {
  id          Int      @id @default(autoincrement())
  year        String
  title       String
  description String
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("timeline_events")
}

model Event {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  shortSummary  String?  @map("short_summary")
  description   String
  eventDate     DateTime @map("event_date")
  location      String?
  imageUrl      String?  @map("image_url")
  importantLink String?  @map("important_link")
  status        String   @default("draft") // "draft" | "published" | "completed"
  isFeatured    Int      @default(0) @map("is_featured") // 1: featured, 0: regular
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  creator       User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("events")
}

model Article {
  id            Int       @id @default(autoincrement())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String
  coverImageUrl String?   @map("cover_image_url")
  category      String    @default("Berita Kampus")
  authorName    String    @map("author_name")
  importantLink String?   @map("important_link")
  status        String    @default("draft") // "draft" | "published"
  isTop         Int       @default(0) @map("is_top") // 1: top article spotlight
  viewsCount    Int       @default(0) @map("views_count")
  createdBy     Int?      @map("created_by")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  creator       User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("articles")
}

model Aspiration {
  id                Int      @id @default(autoincrement())
  fullName          String   @map("full_name")
  email             String?
  senderType        String   @map("sender_type") // "mahasiswa_umj" | "umum"
  faculty           String?
  major             String?
  aspirationContent String   @map("aspiration_content")
  status            String   @default("new") // "new" | "reviewed" | "archived"
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("aspirations")
}
